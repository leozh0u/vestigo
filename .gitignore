# Data: images are large and licence-encumbered (Mapillary is CC-BY-SA).
# The manifest is committed so runs are reproducible; the pixels are not.
data/images/
data/raw/
*.zip

# Model artifacts
ml/checkpoints/
ml/embeddings/
*.pt
*.pth
*.npy

# Cached tool results
.cache/

# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# macOS
.DS_Store

# Training imagery: large, CC-BY-SA, and regenerable from the index
data/train/

# Geocells are derived from the training index, which is committed
ml/geocells.json
ml/embeddings/
ml/checkpoints/

# Natural Earth boundaries: public domain, and a download step
data/boundaries/

# The site
site/node_modules/
site/dist/
# Generated from data/boundaries by scripts/build_globe_textures.py, and
# regenerated by one command, so there is no reason to carry 6 MB in git.
site/public/textures/
# Rendered and generated video. Regenerated by scripts/render-intro.mjs and
# scripts/stitch-intro.mjs, and too large to carry in git.
site/public/opening/*.mp4
site/.render-*/
site/public/textures/earth-night-raw.jpg
site/media/
site/dist/
