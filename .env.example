MAPILLARY_TOKEN=MLY|your_app_id|your_token_here

# One of these, depending on which provider the router points at. None are
# needed to run the tests or any of the experiments in eval/.
ANTHROPIC_API_KEY=sk-ant-your-key-here
MOONSHOT_API_KEY=sk-your-kimi-key-here
OPENAI_API_KEY=sk-your-key-here

# One key reaching most models, including Claude and Kimi. Model names carry
# the vendor: anthropic/claude-sonnet-5, moonshotai/kimi-k2.
OPENROUTER_API_KEY=sk-or-your-key-here
